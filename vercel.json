{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.drhebaelkomy.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "drhebaelkomy.com" }],
      "destination": "https://www.drhebaelkomy.com/:path*",
      "permanent": true
    }
  ]
}
